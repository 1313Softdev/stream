# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (Hostinger MySQL)
# On Hostinger: Host is usually 'localhost' or '127.0.0.1'
# The Database name and user will have your Hostinger username prefix (e.g., u123456789_streamadda)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_streamadda
DB_USER=u123456789_admin
DB_PASSWORD=YourStrongDatabasePassword123!

# Legacy MySQL variables (Alternative)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_streamadda
MYSQL_USER=u123456789_admin
MYSQL_PASSWORD=YourStrongDatabasePassword123!

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production_998877

# Optional API Keys
GEMINI_API_KEY=""
